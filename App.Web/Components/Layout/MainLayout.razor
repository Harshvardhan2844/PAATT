@inherits LayoutComponentBase

<div class="app-shell">
    <header class="app-header">
        <a class="app-brand" href="/">TimeTracker</a>
        <nav class="app-nav" aria-label="Primary navigation">
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <a class="nav-link" href="/admin/employees">Employees</a>
                    <a class="nav-link" href="/admin/clients">Clients</a>
                    <a class="nav-link" href="/admin/projects">Projects</a>
                    <a class="nav-link" href="/admin/assignments">Assignments</a>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Roles="Consultant">
                <Authorized>
                    <a class="nav-link" href="/consultant/projects">My projects</a>
                    <a class="nav-link" href="/consultant/timesheets">My timesheets</a>
                    <ManagerNavigation />
                </Authorized>
            </AuthorizeView>
        </nav>
        <AuthorizeView>
            <Authorized>
                <a class="account-link" href="/Account/Manage">Account</a>
            </Authorized>
            <NotAuthorized>
                <a class="account-link" href="/Account/Login">Sign in</a>
            </NotAuthorized>
        </AuthorizeView>
    </header>
    <main class="app-content">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
