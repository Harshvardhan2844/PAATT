@inherits LayoutComponentBase

<div class="app-shell">
    <header class="app-header">
        <a class="app-brand" href="/" aria-label="WorkLedger home">
            <span class="brand-mark" aria-hidden="true">W</span>
            <span>WorkLedger</span>
        </a>
        <RoleMenu />
        <AuthorizeView>
            <Authorized>
                <div class="account-area">
                    <form action="/Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="/Account/Login" />
                        <button class="sign-out-button" type="submit">Sign out</button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <a class="sign-in-link" href="/Account/Login">Sign in</a>
            </NotAuthorized>
        </AuthorizeView>
    </header>
    <div class="workspace-layout">
        <aside class="app-sidebar" aria-label="Dashboard navigation">
            <RoleNavigation />
        </aside>
        <main class="app-content">
            @Body
        </main>
    </div>
    <footer class="app-footer">
        <span>© @DateTime.UtcNow.Year WorkLedger</span>
        <span>Project allocation &amp; time tracking</span>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
