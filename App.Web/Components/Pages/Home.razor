@page "/"

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Workspace overview | WorkLedger</PageTitle>

<AuthorizeView Roles="Admin">
    <Authorized>
        <section class="overview-hero">
            <p class="eyebrow">ADMINISTRATION</p>
            <h1>Workspace overview</h1>
            <p>Set up the people, clients, projects, and assignments that power time tracking.</p>
        </section>

        <section class="overview-grid" aria-label="Workspace setup">
            <a class="overview-card" href="/admin/clients"><span>01</span><h2>Clients</h2><p>Maintain client companies.</p></a>
            <a class="overview-card" href="/admin/projects"><span>02</span><h2>Projects</h2><p>Set managers and hour budgets.</p></a>
            <a class="overview-card" href="/admin/assignments"><span>03</span><h2>Assignments</h2><p>Connect consultants to projects.</p></a>
            <a class="overview-card" href="/admin/employees"><span>04</span><h2>People</h2><p>Manage access and roles.</p></a>
        </section>
    </Authorized>
    <NotAuthorized>
        <section class="overview-hero">
            <p class="eyebrow">TIME TRACKING</p>
            <h1>Your workspace</h1>
            <p>Review your projects and submit your weekly timesheet.</p>
        </section>
        <section class="overview-grid consultant-grid">
            <a class="overview-card" href="/consultant/projects"><span>01</span><h2>My projects</h2><p>See your active assignments.</p></a>
            <a class="overview-card" href="/consultant/timesheets"><span>02</span><h2>My timesheets</h2><p>Track and submit your hours.</p></a>
        </section>
    </NotAuthorized>
</AuthorizeView>
