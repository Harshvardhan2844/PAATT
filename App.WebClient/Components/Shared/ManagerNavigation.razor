@rendermode InteractiveAuto
@inject IManagerApi Api

@if (_isManager)
{
    <a class="nav-link" href="/manager/timesheets">Review queue</a>
    <a class="nav-link" href="/manager/projects">Managed projects</a>
}

@code {
    private bool _isManager;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isManager = (await Api.GetMyProjectsAsync()).Count > 0;
        }
        catch
        {
            _isManager = false;
        }
    }
}
