@rendermode InteractiveAuto
@implements IDisposable
@inject NavigationManager NavigationManager
@inject RoleViewState RoleState

@if (_ready)
{
    <nav class="role-switcher" aria-label="Role navigation">
        <p class="sidebar-heading">Switch view</p>

        @if (_isAdmin)
        {
            <button type="button" class="role-switch @RoleClass(RoleView.Admin)" @onclick="() => SelectRoleAsync(RoleView.Admin)">
                Admin
            </button>
        }
        @if (_isManager)
        {
            <button type="button" class="role-switch @RoleClass(RoleView.Manager)" @onclick="() => SelectRoleAsync(RoleView.Manager)">
                Manager
            </button>
        }
        @if (_isConsultant)
        {
            <button type="button" class="role-switch @RoleClass(RoleView.Consultant)" @onclick="() => SelectRoleAsync(RoleView.Consultant)">
                Consultant
            </button>
        }

    </nav>
}

@code {
    private bool _ready;
    private bool _isAdmin;
    private bool _isConsultant;
    private bool _isManager;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var state = AuthenticationState is null ? null : await AuthenticationState;
        _isAdmin = state?.User.IsInRole("Admin") == true;
        _isConsultant = state?.User.IsInRole("Consultant") == true;

        _isManager = state?.User.IsInRole("Manager") == true;

        SetRoleFromCurrentLocation();
        NavigationManager.LocationChanged += OnLocationChanged;
        _ready = true;
    }

    private void SelectRoleAsync(RoleView role)
    {
        RoleState.Select(role);
        NavigationManager.NavigateTo(role switch
        {
            RoleView.Admin => "/admin/clients",
            RoleView.Manager => "/manager/timesheets",
            _ => "/consultant/projects"
        });
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        SetRoleFromCurrentLocation();
        _ = InvokeAsync(StateHasChanged);
    }

    private void SetRoleFromCurrentLocation()
    {
        var path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        if (path.StartsWith("admin", StringComparison.OrdinalIgnoreCase) && _isAdmin)
            RoleState.Select(RoleView.Admin);
        else if (path.StartsWith("manager", StringComparison.OrdinalIgnoreCase) && _isManager)
            RoleState.Select(RoleView.Manager);
        else if (_isConsultant)
            RoleState.Select(RoleView.Consultant);
        else if (_isAdmin)
            RoleState.Select(RoleView.Admin);
    }

    private string RoleClass(RoleView role) => RoleState.ActiveView == role ? "active" : string.Empty;

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;
}
