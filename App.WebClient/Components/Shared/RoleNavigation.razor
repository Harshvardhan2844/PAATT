@rendermode InteractiveAuto
@implements IDisposable
@inject NavigationManager NavigationManager

@if (_ready)
{
    <nav aria-label="Role navigation">
        <p class="sidebar-heading">Switch view</p>

        @if (_isAdmin)
        {
            <button type="button" class="role-switch @RoleClass(Role.Admin)" @onclick="() => SelectRoleAsync(Role.Admin)">
                Admin
            </button>
        }
        @if (_isManager)
        {
            <button type="button" class="role-switch @RoleClass(Role.Manager)" @onclick="() => SelectRoleAsync(Role.Manager)">
                Manager
            </button>
        }
        @if (_isConsultant)
        {
            <button type="button" class="role-switch @RoleClass(Role.Consultant)" @onclick="() => SelectRoleAsync(Role.Consultant)">
                Consultant
            </button>
        }

        <div class="role-menu">
            @switch (_activeRole)
            {
                case Role.Admin:
                    <a class="nav-link" href="/admin/clients">Clients</a>
                    <a class="nav-link" href="/admin/projects">Projects</a>
                    <a class="nav-link" href="/admin/assignments">Assignments</a>
                    <a class="nav-link" href="/admin/employees">People</a>
                    break;
                case Role.Manager:
                    <a class="nav-link" href="/manager/timesheets">Review queue</a>
                    <a class="nav-link" href="/manager/projects">Managed projects</a>
                    break;
                case Role.Consultant:
                    <a class="nav-link" href="/consultant/projects">My projects</a>
                    <a class="nav-link" href="/consultant/timesheets">My timesheets</a>
                    break;
            }
        </div>
    </nav>
}

@code {
    private enum Role { Admin, Manager, Consultant }

    private bool _ready;
    private bool _isAdmin;
    private bool _isConsultant;
    private bool _isManager;
    private Role _activeRole;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var state = AuthenticationState is null ? null : await AuthenticationState;
        _isAdmin = state?.User.IsInRole("Admin") == true;
        _isConsultant = state?.User.IsInRole("Consultant") == true;

        _isManager = state?.User.IsInRole("Manager") == true;

        SetRoleFromCurrentLocation();
        NavigationManager.LocationChanged += OnLocationChanged;
        _ready = true;
    }

    private async Task SelectRoleAsync(Role role)
    {
        _activeRole = role;
        await InvokeAsync(StateHasChanged);
        NavigationManager.NavigateTo(role switch
        {
            Role.Admin => "/admin/clients",
            Role.Manager => "/manager/timesheets",
            _ => "/consultant/projects"
        });
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        SetRoleFromCurrentLocation();
        _ = InvokeAsync(StateHasChanged);
    }

    private void SetRoleFromCurrentLocation()
    {
        var path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        if (path.StartsWith("admin", StringComparison.OrdinalIgnoreCase) && _isAdmin)
            _activeRole = Role.Admin;
        else if (path.StartsWith("manager", StringComparison.OrdinalIgnoreCase) && _isManager)
            _activeRole = Role.Manager;
        else if (_isConsultant)
            _activeRole = Role.Consultant;
        else if (_isAdmin)
            _activeRole = Role.Admin;
    }

    private string RoleClass(Role role) => _activeRole == role ? "active" : string.Empty;

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;
}
