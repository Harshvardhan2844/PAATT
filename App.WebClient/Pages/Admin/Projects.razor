@page "/admin/projects"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveAuto
@inject IAdminApi Api

<PageTitle>Projects</PageTitle>

<h1 class="h3 mb-2">Projects</h1>
<p class="text-muted">
    A project belongs to one client. There's no budget field here on purpose — budgeted hours are set
    per consultant, per project, on the <a href="/admin/assignments">Project Assignments</a> screen.
</p>

<ResultAlert Message="@_message" Errors="@_errors" />

@if (!_loading && _clients.Count == 0)
{
    <div class="alert alert-warning py-2">
        You need at least one client before you can create a project.
        <a href="/admin/clients" class="alert-link">Add a client</a> first.
    </div>
}

<div class="card mb-4">
    <div class="card-header">@FormHeading</div>
    <div class="card-body">
        <EditForm Model="_model" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <div class="row g-3">
                <div class="col-md-5">
                    <label class="form-label" for="project-name">Project name</label>
                    <InputText id="project-name" class="form-control" @bind-Value="_model.Name" />
                    <ValidationMessage For="() => _model.Name" class="text-danger small" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="project-client">Client</label>
                    <InputSelect id="project-client" class="form-select" @bind-Value="_model.ClientId">
                        <option value="0">Select a client…</option>
                        @foreach (var client in _clients)
                        {
                            <option value="@client.Id">@client.CompanyName</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => _model.ClientId" class="text-danger small" />
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <div class="form-check">
                        <InputCheckbox id="project-billable" class="form-check-input" @bind-Value="_model.IsBillable" />
                        <label class="form-check-label" for="project-billable">Billable</label>
                    </div>
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary" disabled="@(_busy || _clients.Count == 0)">
                    @(_editingId is null ? "Add project" : "Save changes")
                </button>
                @if (_editingId is not null)
                {
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">Cancel</button>
                }
            </div>
        </EditForm>
    </div>
</div>

@if (_loading)
{
    <p class="text-muted">Loading projects…</p>
}
else if (_projects.Count == 0)
{
    <p class="text-muted">No projects yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">Project</th>
                    <th scope="col">Client</th>
                    <th scope="col">Billable</th>
                    <th scope="col">Manager</th>
                    <th scope="col" class="text-center">Consultants</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var project in _projects)
                {
                    <tr>
                        <td>@project.Name</td>
                        <td>@project.ClientName</td>
                        <td>
                            @if (project.IsBillable)
                            {
                                <span class="badge text-bg-success">Billable</span>
                            }
                            else
                            {
                                <span class="badge text-bg-light text-dark">Non-billable</span>
                            }
                        </td>
                        <td>
                            @if (string.IsNullOrEmpty(project.ManagerName))
                            {
                                <span class="text-muted small">Not assigned</span>
                            }
                            else
                            {
                                <span>@project.ManagerName</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (project.ConsultantCount == 0)
                            {
                                <span class="text-muted">—</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">@project.ConsultantCount</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary me-1" href="@AssignmentsUrl(project)">Assignments</a>
                            <button type="button" class="btn btn-sm btn-outline-secondary me-1"
                                    disabled="@_busy" @onclick="() => StartEdit(project)">
                                Edit
                            </button>
                            <ConfirmButton Disabled="@_busy"
                                           Title="@DeleteHint(project)"
                                           OnConfirmed="() => DeleteAsync(project)" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<ProjectDto> _projects = new();
    private List<ClientDto> _clients = new();
    private ProjectRequest _model = new();
    private int? _editingId;

    private string? _message;
    private List<string>? _errors;
    private bool _loading = true;
    private bool _busy;

    private string FormHeading => _editingId is null ? "Add a project" : "Edit project";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _projects = await Api.GetProjectsAsync();
        _clients = await Api.GetClientsAsync();
        _loading = false;
    }

    private void StartEdit(ProjectDto project)
    {
        ClearFeedback();
        _editingId = project.Id;
        _model = new ProjectRequest
        {
            Name = project.Name,
            ClientId = project.ClientId,
            IsBillable = project.IsBillable
        };
    }

    private void CancelEdit()
    {
        _editingId = null;
        _model = new ProjectRequest();
    }

    private async Task SaveAsync()
    {
        _busy = true;
        ClearFeedback();

        var result = _editingId is null
            ? await Api.CreateProjectAsync(_model)
            : await Api.UpdateProjectAsync(_editingId.Value, _model);

        if (result.Success)
        {
            _message = (_editingId is null ? "Added " : "Updated ") + result.Data!.Name + ".";
            CancelEdit();
            await LoadAsync();
        }
        else
        {
            _errors = result.Errors;
        }

        _busy = false;
    }

    private async Task DeleteAsync(ProjectDto project)
    {
        _busy = true;
        ClearFeedback();

        // Refused by the service if assignments or timesheets exist — we never
        // silently delete someone's logged time.
        var result = await Api.DeleteProjectAsync(project.Id);
        if (result.Success)
        {
            _message = "Deleted " + project.Name + ".";
            if (_editingId == project.Id) CancelEdit();
            await LoadAsync();
        }
        else
        {
            _errors = result.Errors;
        }

        _busy = false;
    }

    private static string AssignmentsUrl(ProjectDto project) => "/admin/assignments/" + project.Id;

    private static string DeleteHint(ProjectDto project) =>
        project.ConsultantCount > 0 || !string.IsNullOrEmpty(project.ManagerName)
            ? "Remove this project's assignments first."
            : "Delete this project.";

    private void ClearFeedback()
    {
        _message = null;
        _errors = null;
    }
}
