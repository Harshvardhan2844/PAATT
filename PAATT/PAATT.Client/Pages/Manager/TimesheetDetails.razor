@page "/manager/timesheets/{TimesheetId:int}"
@rendermode InteractiveAuto
@inject TimesheetApiService Timesheets

<PageTitle>Review Timesheet</PageTitle>
@if (error is not null) { <div class="alert alert-danger">@error</div> }
else if (sheet is null) { <p>Loading timesheet…</p> }
else { <h1>@sheet.ConsultantName — @sheet.ProjectName</h1><p>Week starting @sheet.WeekStartDate · <strong>@sheet.Status</strong> · @sheet.TotalHours hours</p>
<table class="table"><thead><tr><th>Date</th><th>Hours</th><th>Description</th><th>Status</th><th>Feedback</th><th></th></tr></thead><tbody>@foreach (var entry in sheet.Entries) { <tr><td>@entry.WorkDate</td><td>@entry.Hours</td><td>@entry.Description</td><td>@entry.Status</td><td>@entry.Feedback</td><td>@if (sheet.Status == TimesheetStatus.Pending) { <button class="btn btn-sm btn-outline-danger" @onclick="() => RejectEntryAsync(entry.Id)">Reject entry</button> }</td></tr> }</tbody></table>
@if (sheet.Status == TimesheetStatus.Pending) { <div class="card card-body"><InputTextArea class="form-control mb-2" @bind-Value="feedback" placeholder="Required feedback for rejection" /><div><button class="btn btn-success me-2" @onclick="ApproveAsync">Approve</button><button class="btn btn-danger" @onclick="RejectAsync">Reject timesheet</button></div></div> }
<h2 class="h4 mt-4">Review history</h2><ul>@foreach (var review in sheet.Reviews) { <li>@review.CreatedUtc.ToLocalTime(): @review.Action by @review.ReviewerName — @review.Feedback</li> }</ul> }
@code { [Parameter] public int TimesheetId { get; set; } private TimesheetDetailsDto? sheet; private string? feedback; private string? error; protected override Task OnParametersSetAsync() => LoadAsync(); private async Task LoadAsync() { try { error = null; sheet = await Timesheets.GetDetailsAsync(TimesheetId); } catch (Exception exception) { error = exception.Message; } } private async Task ApproveAsync() { try { await Timesheets.ApproveAsync(TimesheetId); await LoadAsync(); } catch (Exception exception) { error = exception.Message; } } private async Task RejectAsync() { if (string.IsNullOrWhiteSpace(feedback)) { error = "Feedback is required."; return; } try { await Timesheets.RejectAsync(TimesheetId, new RejectTimesheetDto { Feedback = feedback }); await LoadAsync(); } catch (Exception exception) { error = exception.Message; } } private async Task RejectEntryAsync(int entryId) { if (string.IsNullOrWhiteSpace(feedback)) { error = "Enter feedback before rejecting an entry."; return; } try { await Timesheets.RejectEntryAsync(entryId, new RejectTimesheetEntryDto { Feedback = feedback }); await LoadAsync(); } catch (Exception exception) { error = exception.Message; } } }
