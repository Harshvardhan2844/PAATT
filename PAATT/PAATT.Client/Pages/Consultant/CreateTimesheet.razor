@page "/consultant/timesheets/create"
@rendermode InteractiveAuto
@inject ProjectApiService ProjectsApi
@inject TimesheetApiService Timesheets

<PageTitle>Create Timesheet</PageTitle>
<h1>Create Timesheet</h1>
@if (error is not null) { <div class="alert alert-danger">@error</div> }
@if (sheet is null)
{
    <EditForm Model="createForm" OnValidSubmit="CreateAsync" class="card card-body"><DataAnnotationsValidator /><ValidationSummary /><label class="form-label">Project</label><InputSelect class="form-select mb-3" @bind-Value="createForm.ProjectId"><option value="0">Select an assigned project</option>@foreach (var project in projects) { <option value="@project.Id">@project.Name — @project.ClientName</option> }</InputSelect><label class="form-label">Week starting</label><InputDate class="form-control mb-3" @bind-Value="createForm.WeekStartDate" /><button class="btn btn-primary align-self-start">Create timesheet</button></EditForm>
}
else
{
    <h2 class="h4">@sheet.ProjectName · week of @sheet.WeekStartDate</h2><p>Status: <strong>@sheet.Status</strong> · Total: @sheet.TotalHours hours</p>
    @if (sheet.Status is TimesheetStatus.Draft or TimesheetStatus.Rejected)
    {
        <EditForm Model="entryForm" OnValidSubmit="AddEntryAsync" class="card card-body mb-3"><DataAnnotationsValidator /><ValidationSummary /><div class="row g-2"><div class="col-md-3"><InputDate class="form-control" @bind-Value="entryForm.WorkDate" /></div><div class="col-md-2"><InputNumber class="form-control" @bind-Value="entryForm.Hours" placeholder="Hours" /></div><div class="col-md-5"><InputText class="form-control" @bind-Value="entryForm.Description" placeholder="Work description" /></div><div class="col-md-2"><button class="btn btn-primary">Add entry</button></div></div><small class="text-muted mt-2">New entries are allowed only for today. The server also enforces the 24-hour daily limit.</small></EditForm>
    }
    <table class="table"><thead><tr><th>Date</th><th>Hours</th><th>Description</th><th>Status</th><th>Feedback</th><th></th></tr></thead><tbody>@foreach (var entry in sheet.Entries) { <tr><td>@entry.WorkDate</td><td>@entry.Hours</td><td>@entry.Description</td><td>@entry.Status</td><td>@entry.Feedback</td><td>@if (CanEdit(entry)) { <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteEntryAsync(entry.Id)">Delete</button> }</td></tr> }</tbody></table>
    @if (sheet.Status is TimesheetStatus.Draft or TimesheetStatus.Rejected) { <button class="btn btn-success" @onclick="SubmitAsync">Submit for review</button> }
}

@code {
    private readonly CreateTimesheetDto createForm = new() { WeekStartDate = GetMonday(AppClock.Today) };
    private readonly CreateTimesheetEntryDto entryForm = new() { WorkDate = AppClock.Today };
    private IReadOnlyList<ProjectDto> projects = [];
    private TimesheetDetailsDto? sheet;
    private string? error;
    protected override async Task OnInitializedAsync() { try { projects = await ProjectsApi.GetMineAsync(); } catch (Exception exception) { error = exception.Message; } }
    private async Task CreateAsync() { try { error = null; var created = await Timesheets.CreateAsync(createForm); sheet = await Timesheets.GetDetailsAsync(created.Id); } catch (Exception exception) { error = exception.Message; } }
    private async Task AddEntryAsync() { if (sheet is null) return; try { error = null; sheet = await Timesheets.AddEntryAsync(sheet.Id, entryForm); entryForm.Hours = 0; entryForm.Description = string.Empty; } catch (Exception exception) { error = exception.Message; } }
    private async Task DeleteEntryAsync(int entryId) { try { error = null; await Timesheets.DeleteEntryAsync(entryId); if (sheet is not null) sheet = await Timesheets.GetDetailsAsync(sheet.Id); } catch (Exception exception) { error = exception.Message; } }
    private async Task SubmitAsync() { if (sheet is null) return; try { error = null; await Timesheets.SubmitAsync(sheet.Id); sheet = await Timesheets.GetDetailsAsync(sheet.Id); } catch (Exception exception) { error = exception.Message; } }
    private bool CanEdit(TimesheetEntryDto entry) => sheet?.Status is TimesheetStatus.Draft or TimesheetStatus.Rejected || entry.Status == TimesheetEntryStatus.Rejected;
    private static DateOnly GetMonday(DateOnly date) => date.AddDays(-((7 + ((int)date.DayOfWeek - (int)DayOfWeek.Monday)) % 7));
}
