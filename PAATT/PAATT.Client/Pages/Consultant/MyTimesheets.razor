@page "/consultant/timesheets"
@rendermode InteractiveAuto
@inject TimesheetApiService Timesheets

<PageTitle>My Timesheets</PageTitle>
<h1>My Timesheets</h1>
@if (error is not null) { <div class="alert alert-danger">@error</div> }
else if (items is null) { <p>Loading timesheets…</p> }
else { <table class="table"><thead><tr><th>Project</th><th>Week</th><th>Hours</th><th>Status</th></tr></thead><tbody>@foreach (var sheet in items) { <tr><td>@sheet.ProjectName</td><td>@sheet.WeekStartDate</td><td>@sheet.TotalHours</td><td>@sheet.Status</td></tr> }</tbody></table> }

@code { private IReadOnlyList<TimesheetDto>? items; private string? error; protected override async Task OnInitializedAsync() { try { items = await Timesheets.GetMineAsync(); } catch (Exception exception) { error = exception.Message; } } }
