@page "/admin/projects"
@rendermode InteractiveAuto
@inject ProjectApiService ProjectsApi
@inject ClientApiService ClientsApi
@inject EmployeeApiService EmployeesApi
<PageTitle>Projects</PageTitle>
<h1>Projects</h1>
@if (error is not null) { <div class="alert alert-danger">@error</div> }
<EditForm Model="form" OnValidSubmit="CreateAsync" class="card card-body mb-4"><DataAnnotationsValidator /><ValidationSummary /><div class="row g-2"><div class="col-md-3"><InputSelect class="form-select" @bind-Value="form.ClientId"><option value="0">Select client</option>@foreach (var client in clients) { <option value="@client.Id">@client.Name</option> }</InputSelect></div><div class="col-md-3"><InputText class="form-control" @bind-Value="form.Name" placeholder="Project name" /></div><div class="col-md-3"><InputSelect class="form-select" @bind-Value="form.ProjectManagerId"><option value="">Select manager</option>@foreach (var employee in employees) { <option value="@employee.Id">@employee.Name</option> }</InputSelect></div><div class="col-md-2"><InputNumber class="form-control" @bind-Value="form.BudgetedHours" placeholder="Budgeted hours" /></div><div class="col-md-1"><button class="btn btn-primary">Add</button></div></div></EditForm>
@if (items is null) { <p>Loading projects…</p> } else { <table class="table"><thead><tr><th>Project</th><th>Client</th><th>Manager</th><th>Consultants</th><th>Hours</th></tr></thead><tbody>@foreach (var item in items) { <tr><td>@item.Name</td><td>@item.ClientName</td><td>@item.ProjectManagerName</td><td>@string.Join(", ", item.Consultants.Select(x => x.Name))</td><td>@item.BudgetedHours</td></tr> }</tbody></table> }
@code { private readonly CreateProjectDto form = new(); private IReadOnlyList<ClientDto> clients = []; private IReadOnlyList<EmployeeDto> employees = []; private IReadOnlyList<ProjectDto>? items; private string? error; protected override async Task OnInitializedAsync() { try { clients = await ClientsApi.GetAllAsync(); employees = await EmployeesApi.GetAllAsync(); items = await ProjectsApi.GetAllAsync(); } catch (Exception exception) { error = exception.Message; } } private async Task CreateAsync() { try { await ProjectsApi.CreateAsync(form); items = await ProjectsApi.GetAllAsync(); form.Name = form.ProjectManagerId = string.Empty; form.ClientId = 0; form.BudgetedHours = 0; } catch (Exception exception) { error = exception.Message; } } }
