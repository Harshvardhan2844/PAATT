@inject AccountApiService Account
@inject NavigationManager Navigation
<div class="top-row ps-3 navbar navbar-dark"><div class="container-fluid"><a class="navbar-brand" href="">PAATT</a></div></div>
<input type="checkbox" title="Navigation menu" class="navbar-toggler" />
<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3"><NavLink class="nav-link" href="" Match="NavLinkMatch.All">Dashboard</NavLink></div>
        @if (HasRole("Admin"))
        {
            <div class="nav-item px-3 text-uppercase text-secondary small">Admin</div><div class="nav-item px-3"><NavLink class="nav-link" href="admin/clients">Clients</NavLink></div><div class="nav-item px-3"><NavLink class="nav-link" href="admin/employees">Employees</NavLink></div><div class="nav-item px-3"><NavLink class="nav-link" href="admin/projects">Projects</NavLink></div>
        }
        @if (HasRole("ProjectManager"))
        {
            <div class="nav-item px-3 text-uppercase text-secondary small">Project manager</div><div class="nav-item px-3"><NavLink class="nav-link" href="manager/timesheets">Timesheet review</NavLink></div>
        }
        @if (HasRole("Consultant"))
        {
            <div class="nav-item px-3 text-uppercase text-secondary small">Consultant</div><div class="nav-item px-3"><NavLink class="nav-link" href="consultant/projects">My Projects</NavLink></div><div class="nav-item px-3"><NavLink class="nav-link" href="consultant/timesheets">My Timesheets</NavLink></div><div class="nav-item px-3"><NavLink class="nav-link" href="consultant/timesheets/create">Create Timesheet</NavLink></div>
        }
        @if (currentUser is not null)
        {
            <div class="nav-item px-3 mt-3"><button class="nav-link btn btn-link text-start p-0" @onclick="LogoutAsync">Sign out (@currentUser.Name)</button></div>
        }
    </nav>
</div>
@code {
    private CurrentUserDto? currentUser;
    protected override async Task OnInitializedAsync() { try { currentUser = await Account.GetCurrentUserAsync(); } catch { } }
    private bool HasRole(string role) => currentUser?.Roles.Contains(role, StringComparer.OrdinalIgnoreCase) == true;
    private async Task LogoutAsync() { await Account.LogoutAsync(); Navigation.NavigateTo("/login", forceLoad: true); }
}